<style>
:root{--g1-red:#C4170C;--g1-red-h:#A0120A;--g1-black:#1A1A1A;--g1-text:#333;--g1-muted:#717171;--g1-light:#F2F2F2;--g1-border:#E0E0E0;--g1-link:#0066B3;--g1-gold:#C9A14A;--g1-green:#1F6B3E}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;color:var(--g1-text);background:#fff;line-height:1.55;font-size:16px}

.g1-topbar{background:var(--g1-black);color:#fff;padding:6px 16px;font-size:11px;display:flex;justify-content:space-between;align-items:center}
.g1-header-main{display:flex;align-items:center;padding:12px 24px;border-bottom:4px solid var(--g1-red);background:#fff}
.g1-logo{font-family:'Arial Black',Arial,sans-serif;font-size:36px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;line-height:1}
.g1-section-tag{margin-left:14px;padding-left:14px;border-left:1px solid var(--g1-border);font-size:15px;font-weight:700;color:var(--g1-black);line-height:1;text-transform:uppercase;letter-spacing:.5px}
.g1-breadcrumb{background:var(--g1-light);padding:8px 24px;font-size:12px;border-bottom:1px solid var(--g1-border);color:var(--g1-muted)}
.g1-breadcrumb a{color:var(--g1-link);text-decoration:none}

.urgency-bar{background:var(--g1-red);color:#fff;padding:11px 24px;text-align:center;font-size:13px;letter-spacing:.5px;font-weight:600}
.urgency-bar strong{font-weight:900}

.sticky-mobile{position:fixed;bottom:0;left:0;right:0;background:var(--g1-red);padding:11px 16px;display:none;z-index:200;box-shadow:0 -4px 14px rgba(0,0,0,.18)}
.sticky-mobile a{display:block;background:#fff;color:var(--g1-red);text-align:center;padding:13px;font-size:13px;font-weight:900;letter-spacing:1px;text-transform:uppercase;text-decoration:none}
@media(max-width:768px){.sticky-mobile{display:block}body{padding-bottom:75px}}

.hero{background:#fff;border-bottom:1px solid var(--g1-border);padding:28px 24px 22px;text-align:center}
.hero .badge{display:inline-block;padding:5px 14px;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:900;margin-bottom:14px;color:#fff}
.hero .badge.tier1{background:var(--g1-green)}
.hero .badge.tier2{background:var(--g1-gold);color:var(--g1-black)}
.hero .badge.tier3{background:var(--g1-black)}
.hero h1{font-family:Arial,Helvetica,sans-serif;font-size:30px;line-height:1.25;color:var(--g1-black);max-width:680px;margin:0 auto 10px;font-weight:900;letter-spacing:-.3px}
.hero h1 .name{color:var(--g1-red)}
.hero .sub{font-size:16px;color:var(--g1-text);max-width:560px;margin:0 auto;line-height:1.5}

.hero-img-wrap{max-width:1100px;margin:18px auto 0;padding:0 24px}
.hero-img{width:100%;height:auto;display:block}

.score-bar{max-width:520px;margin:18px auto 0;background:var(--g1-light);padding:14px 20px;text-align:left}
.score-bar .sl{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;color:var(--g1-muted);text-transform:uppercase;letter-spacing:1px;font-weight:900;margin-bottom:8px}
.score-bar .sn{font-size:14px;font-weight:900;color:var(--g1-black)}
.score-track{height:8px;background:var(--g1-border);overflow:hidden}
.score-fill{height:100%;transition:width 1.2s ease}
.score-fill.tier1{background:linear-gradient(90deg,var(--g1-red),var(--g1-green))}
.score-fill.tier2{background:linear-gradient(90deg,var(--g1-red),var(--g1-gold))}
.score-fill.tier3{background:var(--g1-red)}

.container{max-width:760px;margin:0 auto;padding:28px 24px}

.section{background:#fff;border:1px solid var(--g1-border);padding:24px;margin-bottom:20px}
.section .label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:10px}
.section h2{font-family:Arial,Helvetica,sans-serif;font-size:22px;color:var(--g1-black);margin-bottom:12px;line-height:1.3;font-weight:900;letter-spacing:-.2px}
.section p{margin-bottom:12px;color:var(--g1-text);font-size:15px}
.section p strong{color:var(--g1-black);font-weight:700}

.preview-box{background:var(--g1-black);color:#fff;padding:24px;margin-bottom:20px;border-left:4px solid var(--g1-red)}
.preview-box .label{color:var(--g1-red);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:900;margin-bottom:10px}
.preview-box h2{color:#fff;font-size:21px;line-height:1.3;margin-bottom:12px;font-weight:900}
.preview-box p{color:#D8D8D8;margin-bottom:14px;font-size:14px}
.fact-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px dotted rgba(255,255,255,.18);font-size:14px;gap:14px}
.fact-row:last-child{border-bottom:none}
.fact-row .fl{color:#B0B0B0;flex:1}
.fact-row .fv{font-weight:900;color:#fff;text-align:right;white-space:nowrap}

.cta-primary{display:block;background:var(--g1-red);color:#fff;font-weight:900;font-size:15px;letter-spacing:1px;text-transform:uppercase;padding:18px 24px;border:none;text-decoration:none;text-align:center;cursor:pointer;width:100%;margin-bottom:10px;transition:background .15s}
.cta-primary:hover{background:var(--g1-red-h)}
.cta-secondary{display:block;background:transparent;color:var(--g1-black);font-weight:900;font-size:13px;letter-spacing:1px;text-transform:uppercase;padding:14px 24px;border:2px solid var(--g1-black);text-decoration:none;text-align:center;cursor:pointer;width:100%;transition:all .15s}
.cta-secondary:hover{background:var(--g1-black);color:#fff}
.cta-whats{background:#25D366;border-color:#25D366;color:#fff}
.cta-whats:hover{background:#1FB855;border-color:#1FB855;color:#fff}

.scarcity{background:#FFF8F7;border:1px solid #F5C9C5;padding:13px 18px;margin:14px 0;font-size:13px;color:var(--g1-text);text-align:center;border-left:4px solid var(--g1-red)}
.scarcity strong{color:var(--g1-red)}

.cal-placeholder{background:var(--g1-light);border:1px dashed var(--g1-border);padding:30px 24px;text-align:center;color:var(--g1-muted);font-size:13px;margin-top:14px}

/* PROPERTY GRID — the BIG new section */
.props-section{background:#fff;border-top:4px solid var(--g1-red);padding:28px 0;margin-bottom:20px}
.props-section .ps-header{padding:0 24px;margin-bottom:18px}
.props-section .label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:8px}
.props-section h2{font-family:Arial,Helvetica,sans-serif;font-size:24px;color:var(--g1-black);line-height:1.3;font-weight:900;letter-spacing:-.2px;margin-bottom:8px}
.props-section .ps-sub{font-size:14px;color:var(--g1-muted);line-height:1.5}
.props-section .ps-stats{display:flex;gap:18px;margin-top:14px;font-size:12px;color:var(--g1-muted);flex-wrap:wrap}
.props-section .ps-stats span{display:inline-flex;align-items:center;gap:6px}
.props-section .ps-stats strong{color:var(--g1-black);font-weight:900;font-size:13px}

.props-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:0 24px}
.prop-card{background:#fff;border:1px solid var(--g1-border);overflow:hidden;transition:all .2s ease;display:flex;flex-direction:column}
.prop-card:hover{border-color:var(--g1-red);box-shadow:-3px 3px 0 var(--g1-red)}
.prop-card .img-wrap{position:relative;width:100%;height:180px;overflow:hidden;background:var(--g1-light)}
.prop-card img{width:100%;height:100%;object-fit:cover;display:block}
.prop-card .badge-strip{position:absolute;top:8px;left:8px;display:flex;gap:6px;flex-wrap:wrap}
.prop-card .b-badge{background:var(--g1-red);color:#fff;font-size:9px;padding:3px 7px;font-weight:900;letter-spacing:.5px;text-transform:uppercase}
.prop-card .b-badge.off{background:var(--g1-black)}
.prop-card .b-badge.verif{background:var(--g1-green)}
.prop-card .p-meta{padding:14px;display:flex;flex-direction:column;flex:1}
.prop-card .p-bldg{font-size:11px;color:var(--g1-red);font-weight:900;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}
.prop-card .p-title{font-size:15px;font-weight:900;color:var(--g1-black);line-height:1.3;margin-bottom:6px}
.prop-card .p-loc{font-size:12px;color:var(--g1-muted);margin-bottom:10px}
.prop-card .p-specs{display:flex;gap:14px;margin-bottom:10px;font-size:12px;color:var(--g1-text);border-top:1px dotted var(--g1-border);border-bottom:1px dotted var(--g1-border);padding:8px 0}
.prop-card .p-specs span{display:flex;flex-direction:column}
.prop-card .p-specs strong{font-size:14px;font-weight:900;color:var(--g1-black)}
.prop-card .p-specs em{font-size:10px;color:var(--g1-muted);font-style:normal;text-transform:uppercase;letter-spacing:.5px}
.prop-card .p-price{font-size:20px;font-weight:900;color:var(--g1-black);margin-bottom:4px;letter-spacing:-.5px}
.prop-card .p-price-sub{font-size:11px;color:var(--g1-muted);margin-bottom:12px}
.prop-card .p-action{margin-top:auto}
.prop-card .p-action a{display:block;background:var(--g1-light);color:var(--g1-black);font-size:12px;font-weight:900;letter-spacing:.5px;text-transform:uppercase;padding:11px;text-align:center;text-decoration:none;transition:all .15s}
.prop-card .p-action a:hover{background:var(--g1-red);color:#fff}

.props-footer{padding:16px 24px 0;font-size:12px;color:var(--g1-muted);text-align:center;line-height:1.5;border-top:1px solid var(--g1-border);margin:18px 24px 0}
.props-footer a{color:var(--g1-link);text-decoration:none}

/* BUILDING GRID (smaller cards) */
.bldg-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:16px 0 6px}
.bldg-card{background:#fff;border:1px solid var(--g1-border);overflow:hidden}
.bldg-card img{width:100%;height:130px;object-fit:cover;display:block;background:var(--g1-light)}
.bldg-card .bm{padding:11px 13px}
.bldg-card .bn{font-weight:900;color:var(--g1-black);font-size:13px;margin-bottom:3px;line-height:1.3}
.bldg-card .bz{font-size:10px;color:var(--g1-red);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;font-weight:900}
.bldg-card .bp{font-size:12px;color:var(--g1-text);font-weight:700}

/* BONUSES */
.bonuses-master{background:#FFFCF2;border:2px solid var(--g1-gold);padding:26px;margin-bottom:20px;position:relative}
.bonuses-master::before{content:"✦ EXCLUSIVO";position:absolute;top:-11px;left:20px;background:var(--g1-gold);color:#fff;padding:4px 12px;font-size:11px;font-weight:900;letter-spacing:1px}
.bonuses-master h2{font-size:22px;color:var(--g1-black);text-align:center;margin-bottom:8px;font-weight:900}
.bonuses-master .bm-sub{text-align:center;font-size:14px;color:var(--g1-muted);margin-bottom:20px;line-height:1.5}
.bonus-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px}
.bonus-card{background:#fff;border:1px solid var(--g1-border);overflow:hidden;display:flex;flex-direction:column}
.bonus-card img{width:100%;height:150px;object-fit:cover;display:block;background:var(--g1-light)}
.bonus-card .bcc{padding:16px;flex:1;display:flex;flex-direction:column}
.bonus-card .bcl{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:6px}
.bonus-card .bct{font-size:17px;font-weight:900;color:var(--g1-black);margin-bottom:10px;line-height:1.3}
.bonus-card .bcd{font-size:13px;color:var(--g1-text);line-height:1.5;margin-bottom:12px;flex:1}
.bonus-card ul{list-style:none;padding:0;margin:0 0 12px;font-size:12px;color:var(--g1-text);line-height:1.6}
.bonus-card li{padding-left:17px;position:relative;margin-bottom:3px}
.bonus-card li::before{content:"✓";position:absolute;left:0;color:var(--g1-red);font-weight:900}
.bonus-card .bcv{margin-top:auto;border-top:1px dotted var(--g1-border);padding-top:11px;font-size:12px;color:var(--g1-muted)}
.bonus-card .bcv strong{display:block;color:var(--g1-green);font-size:13px;margin-top:2px;font-weight:900}

.value-stack{background:var(--g1-black);color:#fff;padding:18px;text-align:center;margin-top:6px}
.value-stack .vsl{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:6px}
.value-stack .vsv{font-size:22px;font-weight:900;line-height:1.3;margin-bottom:4px}
.value-stack .vsv .strike{text-decoration:line-through;opacity:.4;font-size:17px;margin-right:8px}
.value-stack .vsx{font-size:12px;color:#C5C5C5}

/* TESTIMONIALS */
.testimonial{background:var(--g1-light);padding:20px;margin-bottom:12px;font-style:italic;font-size:15px;line-height:1.55;color:var(--g1-text);border-left:4px solid var(--g1-red)}
.testimonial cite{display:block;margin-top:10px;font-size:11px;font-style:normal;color:var(--g1-muted);letter-spacing:1px;text-transform:uppercase;font-weight:900}

.g1-footer{background:var(--g1-black);color:#fff;padding:24px;text-align:center;font-size:12px;margin-top:24px}
.g1-footer .brand{font-family:'Arial Black',Arial,sans-serif;font-size:22px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;margin-bottom:6px}
.g1-footer a{color:#FFCFCB;text-decoration:none}

.legal-disc{font-size:11px;color:var(--g1-muted);padding:13px;background:var(--g1-light);margin-top:14px;line-height:1.5;border-left:3px solid var(--g1-border)}

@media(max-width:680px){
.hero h1{font-size:22px}.section h2{font-size:18px}.container{padding:22px 14px}
.preview-box{padding:22px}.bonuses-master{padding:22px 16px}.bonus-grid{grid-template-columns:1fr;gap:14px}
.bldg-grid{grid-template-columns:1fr;gap:12px}.bldg-card img{height:160px}
.props-grid{grid-template-columns:1fr;gap:12px;padding:0 16px}
.props-section .ps-header{padding:0 16px}.props-footer{margin:18px 16px 0;padding:14px 0 0}
.value-stack .vsv{font-size:18px}.hero-img-wrap{padding:0 14px}
.g1-topbar{padding:5px 12px;font-size:10px}.g1-header-main{padding:10px 14px}.g1-logo{font-size:28px}.g1-section-tag{font-size:12px;margin-left:10px;padding-left:10px}
.g1-breadcrumb{padding:7px 14px;font-size:11px}
}

.g1-team{background:var(--g1-light);border-top:4px solid var(--g1-red);padding:24px;margin:0 0 20px;font-family:Arial,Helvetica,sans-serif}
.g1-team-header{margin-bottom:18px}
.g1-team-header .label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:8px}
.g1-team-header h3{font-size:22px;font-weight:900;color:var(--g1-black);line-height:1.3;margin-bottom:8px;letter-spacing:-.2px}
.g1-team-header p{font-size:14px;color:var(--g1-text);line-height:1.55;margin-bottom:0}
.g1-team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.g1-team-card{background:#fff;padding:16px;border-top:3px solid var(--g1-red);display:flex;gap:14px;align-items:flex-start}
.g1-team-photo{flex-shrink:0;width:60px;height:60px;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;font-family:'Arial Black',Arial,sans-serif;letter-spacing:-.5px}
.g1-team-photo.bs-bg{background:#0066B3}
.g1-team-photo.ac-bg{background:var(--g1-red)}
.g1-team-photo.dc-bg{background:var(--g1-green)}
.g1-team-photo.na-bg{background:var(--g1-black)}
.g1-team-meta{flex:1;min-width:0}
.g1-team-name{font-size:14px;font-weight:900;color:var(--g1-black);margin-bottom:2px;line-height:1.2}
.g1-team-role{font-size:10px;color:var(--g1-red);text-transform:uppercase;letter-spacing:.5px;font-weight:900;margin-bottom:8px;line-height:1.3}
.g1-team-bio{font-size:12px;color:var(--g1-text);line-height:1.5}
@media(max-width:600px){.g1-team-grid{grid-template-columns:1fr}.g1-team-card{padding:14px}.g1-team-header h3{font-size:19px}}
</style>
</head>
<body>

<div class="g1-topbar"><div>Edição Digital — 19 de maio de 2026</div><div></div></div>
<div class="g1-header-main"><div class="g1-logo">P1</div><div class="g1-section-tag">Resultado do Diagnóstico</div></div>
<div class="g1-breadcrumb"><a href="#">P1</a> &rsaquo; <a href="#">Patrimônio</a> &rsaquo; Diagnóstico Personalizado</div>

<div class="urgency-bar" id="urgencyBar"></div>

<div class="hero">
  <div class="badge" id="tierBadge"></div>
  <h1 id="heroHeadline"></h1>
  <p class="sub" id="heroSub"></p>
  <div class="score-bar">
    <div class="sl"><span>Heritage Score</span><span class="sn" id="scoreText"></span></div>
    <div class="score-track"><div class="score-fill" id="scoreFill"></div></div>
  </div>
</div>

<div class="hero-img-wrap">
  <img class="hero-img" src="img/hero_result.png&q=80&auto=format&fit=crop" alt="Família brasileira em Miami" loading="eager">
</div>

<div class="container">

  <!-- PREVIEW DOSSIÊ -->
  <div class="preview-box">
    <div class="label">Prévia do seu dossiê personalizado · PDF</div>
    <h2 id="dossierTitle"></h2>
    <p id="dossierIntro"></p>
    <div id="dossierFacts"></div>
  </div>

  <!-- CTA PRINCIPAL -->
  <div class="section" id="ctaSection" style="border-top:4px solid var(--g1-red)">
    <div class="label" id="ctaLabel"></div>
    <h2 id="ctaTitle"></h2>
    <p id="ctaIntro"></p>
    <div class="scarcity" id="scarcityBox"></div>
    <div id="ctaButtons"></div>
    <div id="calendlyWrap" style="display:none;">
      <div class="cal-placeholder">
        Após clicar em <strong>Agendar minha reunião</strong>, você será direcionado para a agenda do corretor parceiro.
        <br><small>(Em produção, widget Calendly embedded — placeholder <code>CALENDLY_URL</code>)</small>
      </div>
    </div>
  </div>

  <!-- BÔNUS -->
  <div class="bonuses-master">
    <h2>Bônus incluídos no seu pacote</h2>
    <p class="bm-sub">Além do diagnóstico patrimonial e da reunião com o corretor parceiro, você recebe dois bônus que cuidam de duas perguntas que todo empresário brasileiro faz na sequência: <em>"e os filhos?"</em> e <em>"e se eu pudesse gerar mais renda em dólar além do aluguel?"</em></p>
    <div class="bonus-grid">
      <div class="bonus-card">
        <img src="img/bonus_education.png&q=80&auto=format" alt="Estudantes em escola internacional bilíngue Miami">
        <div class="bcc">
          <div class="bcl">Bônus 1 · Incluído</div>
          <div class="bct">Concierge Educacional Heritage</div>
          <div class="bcd">Assessoria completa pra colocar os filhos em uma das 4 escolas internacionais bilíngues onde estão os filhos da comunidade brasileira de Miami.</div>
          <ul>
            <li>Avaliação do perfil vs critérios das 4 escolas</li>
            <li>Cushman · Carrollton · Beacon · ASD</li>
            <li>Calendário de aplicação personalizado</li>
            <li>Conexão com pais brasileiros atuais (referências)</li>
            <li>Suporte com transcripts e documentação</li>
          </ul>
          <div class="bcv">Valor referência consultoria especializada:<strong>~US$ 8.000</strong></div>
        </div>
      </div>
      <div class="bonus-card">
        <img src="img/bonus_business.png&q=80&auto=format" alt="Empresária brasileira em escritório Miami">
        <div class="bcc">
