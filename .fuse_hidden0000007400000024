<style>
:root{--g1-red:#C4170C;--g1-red-h:#A0120A;--g1-black:#1A1A1A;--g1-text:#333;--g1-muted:#717171;--g1-light:#F2F2F2;--g1-border:#E0E0E0;--g1-green:#1F6B3E}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;color:var(--g1-text);background:#fff;line-height:1.55;font-size:16px;min-height:100vh;display:flex;flex-direction:column}

.g1-topbar{background:var(--g1-black);color:#fff;padding:6px 16px;font-size:11px;display:flex;justify-content:space-between;align-items:center}
.g1-header-main{display:flex;align-items:center;padding:12px 24px;border-bottom:4px solid var(--g1-red);background:#fff}
.g1-logo{font-family:'Arial Black',Arial,sans-serif;font-size:36px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;line-height:1}
.g1-section-tag{margin-left:14px;padding-left:14px;border-left:1px solid var(--g1-border);font-size:15px;font-weight:700;color:var(--g1-black);line-height:1;text-transform:uppercase;letter-spacing:.5px}

.container{flex:1;max-width:680px;margin:0 auto;padding:40px 24px;width:100%}

.check-circle{width:84px;height:84px;background:var(--g1-green);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:scaleIn .5s ease}
.check-circle svg{width:46px;height:46px;fill:none;stroke:#fff;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
@keyframes scaleIn{from{transform:scale(0)}to{transform:scale(1)}}

h1{font-family:Arial,Helvetica,sans-serif;font-size:30px;line-height:1.25;color:var(--g1-black);margin-bottom:14px;text-align:center;font-weight:900;letter-spacing:-.3px}
.sub{font-size:17px;color:var(--g1-text);text-align:center;margin-bottom:32px;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.5}
.sub strong{color:var(--g1-black);font-weight:700}

.kicker{display:inline-block;background:var(--g1-red);color:#fff;padding:4px 11px;font-size:11px;text-transform:uppercase;font-weight:900;letter-spacing:1px;margin-bottom:14px}

.next-steps{background:#fff;border:1px solid var(--g1-border);border-top:4px solid var(--g1-red);padding:24px;margin-bottom:20px}
.next-steps .label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--g1-red);font-weight:900;margin-bottom:14px}
.next-steps h2{font-size:21px;color:var(--g1-black);margin-bottom:18px;font-weight:900}
.step-list{padding:0;margin:0;list-style:none;counter-reset:step}
.step-item{padding:14px 0 14px 48px;position:relative;border-bottom:1px solid var(--g1-border);counter-increment:step}
.step-item:last-child{border-bottom:none}
.step-item::before{content:counter(step);position:absolute;left:0;top:12px;width:32px;height:32px;background:var(--g1-red);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px}
.step-item .when{font-size:11px;color:var(--g1-red);text-transform:uppercase;letter-spacing:1px;font-weight:900;margin-bottom:4px}
.step-item .what{font-size:14px;color:var(--g1-text);line-height:1.5}
.step-item .what strong{color:var(--g1-black);font-weight:700}

.whats-cta{background:#25D366;color:#fff;padding:22px;text-align:center;margin-bottom:20px;cursor:pointer;text-decoration:none;display:block;transition:background .2s}
.whats-cta:hover{background:#1FB855}
.whats-cta .wt{font-size:11px;text-transform:uppercase;letter-spacing:2px;opacity:.9;margin-bottom:8px;font-weight:900}
.whats-cta .wm{font-size:21px;font-weight:900;line-height:1.3}
.whats-cta .ws{font-size:13px;opacity:.9;margin-top:6px}

.share-box{background:var(--g1-light);border:1px dashed var(--g1-red);padding:22px;text-align:center;margin-bottom:20px}
.share-box h3{font-size:17px;color:var(--g1-black);margin-bottom:8px;font-weight:900}
.share-box p{font-size:13px;color:var(--g1-muted);margin-bottom:14px;line-height:1.5}
.share-btn{display:inline-block;background:#fff;border:2px solid var(--g1-black);color:var(--g1-black);font-weight:900;padding:11px 22px;font-size:13px;letter-spacing:1px;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:all .15s;font-family:inherit}
.share-btn:hover{background:var(--g1-black);color:#fff}

.g1-footer{background:var(--g1-black);color:#fff;padding:20px 24px;text-align:center;font-size:12px}
.g1-footer .brand{font-family:'Arial Black',Arial,sans-serif;font-size:20px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;margin-bottom:4px}
.g1-footer a{color:#FFCFCB;text-decoration:none}

@media(max-width:600px){
.g1-topbar{padding:5px 12px;font-size:10px}.g1-header-main{padding:10px 14px}.g1-logo{font-size:28px}.g1-section-tag{font-size:12px;margin-left:10px;padding-left:10px}
h1{font-size:24px}.container{padding:24px 16px}.step-item{padding-left:42px}.step-item::before{width:28px;height:28px;font-size:12px}
}
</style>
</head>
