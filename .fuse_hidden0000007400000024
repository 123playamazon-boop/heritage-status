    fbq('trackCustom','Tier'+tier+'Confirmed',{channel:channel});
    if(tier===1)fbq('track','Schedule');
  }
  if(window.clarity){clarity('event','tier_'+tier+'_confirmed');clarity('set','final_tier',String(tier))}

  var content={
    booked:{h1:'Reunião agendada. Vejo você em breve.',sub:'Sua reunião foi confirmada na agenda do corretor parceiro. Você recebeu o convite no email com link do Zoom/Meet. <strong>Reserve 30 minutos sem interrupções.</strong>',stepsTitle:'Como aproveitar ao máximo seus 30 minutos',steps:[['HOJE (em até 15min)','Seu <strong>relatório personalizado em PDF</strong> chega no email. Leia antes da reunião.'],['ATÉ 1 DIA ANTES','Prepare 2 ou 3 perguntas específicas. Quanto mais técnicas, mais útil a reunião.'],['NA REUNIÃO (30min)','Revisamos seu dossiê, discutimos 3-5 edifícios concretos, falamos sobre estruturação tributária.'],['ATÉ 7 DIAS DEPOIS','Você recebe lista de imóveis específicos (incluindo off-market). Visitas virtuais ou presenciais agendadas.']]},
    email:{h1:'Recebido. Seu plano de 90 dias está sendo preparado.',sub:'Você está na <strong>fila Tier 2</strong>. Vamos te enviar nos próximos 7 dias o relatório completo + sequência de preparação.',stepsTitle:'Sua jornada de preparação',steps:[['HOJE','Relatório personalizado em PDF chega no email em até 15min.'],['DIA 3','Email com Planilha da Calculadora Triplo Verão aplicada ao seu perfil.'],['DIA 7','Checklist tributário para você levar ao seu contador (CBE, LLC, Lei 14.754).'],['DIA 14','Convite para webinar mensal com o corretor parceiro + sessão Q&A.'],['QUANDO ESTIVER PRONTO','Você sobe automaticamente para Tier 1 e ganha agenda direta com o corretor.']]},
    newsletter:{h1:'Bem-vindo à sua jornada de internacionalização.',sub:'Você foi adicionado à nossa newsletter mensal exclusiva. <strong>Sem ruído, sem spam.</strong> Um email por mês com conteúdo aprofundado sobre patrimônio Brasil-EUA.',stepsTitle:'O que você vai receber',steps:[['HOJE','Manual do Iniciante em Internacionalização Patrimonial (PDF, 24 páginas).'],['MÊS 1','Como funciona a Lei 14.754/2023 — guia técnico em linguagem simples.'],['MÊS 2','Estruturação CBE e LLC americana — quando faz sentido cada uma.'],['MÊS 3','Miami vs Orlando — comparativo completo com planilhas reais.'],['QUANDO EVOLUIR','Quando seu perfil patrimonial ou timeline mudarem, você é convidado para o diagnóstico atualizado.']]}
  };
  var c=channel==='email'?content.email:(channel==='newsletter'?content.newsletter:content.booked);

  document.getElementById('thankH1').textContent=c.h1;
  document.getElementById('thankSub').innerHTML=c.sub;
  document.getElementById('stepsTitle').textContent=c.stepsTitle;
  var html='';c.steps.forEach(function(s){html+='<li class="step-item"><div class="when">'+s[0]+'</div><div class="what">'+s[1]+'</div></li>'});
  document.getElementById('stepList').innerHTML=html;

  document.getElementById('shareWhats').addEventListener('click',function(e){
    e.preventDefault();
    var txt=encodeURIComponent('Acabei de fazer um diagnóstico patrimonial focado em real estate Miami — bem profundo e gratuito. Acho que pode te interessar: '+window.location.origin);
    window.open('https://wa.me/?text='+txt,'_blank');
    if(window.fbq)fbq('trackCustom','ShareWhatsApp');
    if(window.clarity)clarity('event','share_whatsapp');
  });
  document.getElementById('whatsLink').addEventListener('click',function(){
    if(window.fbq)fbq('trackCustom','WhatsAppDirectClick',{tier:tier});
    if(window.clarity)clarity('event','whatsapp_direct_click');
  });
})();
