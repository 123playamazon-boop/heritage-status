.intro-highlights{background:var(--g1-light);padding:18px 20px;border-left:4px solid var(--g1-red);margin:18px 0;font-size:14px}
.intro-highlights .ih-h{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:1px;color:var(--g1-red);margin-bottom:10px}
.intro-highlights ul{list-style:none;padding:0;margin:0}
