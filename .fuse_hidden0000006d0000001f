<script>
(function(){
  var answers={};var totalScore=0;var quizStarted=false;var TOTAL_QS=7;
  var urlParams=new URLSearchParams(window.location.search);
  var sourceAngle=urlParams.get('angle')||urlParams.get('utm_campaign')||'unknown';

  function updateProgress(q){
    if(q===0){
      document.getElementById('progFill').style.width='0%';
      document.getElementById('progLabel').textContent='Antes de começar — Apresentação';
      return;
    }
    var pct=Math.min(100,(q/TOTAL_QS)*100);
    document.getElementById('progFill').style.width=pct+'%';
    document.getElementById('progLabel').textContent=q<=TOTAL_QS?'Pergunta '+q+' de '+TOTAL_QS:'Finalizando…';
  }

  function goToQ(q){
    document.querySelectorAll('.question-wrap').forEach(function(el){el.classList.remove('active')});
    var next=document.querySelector('.question-wrap[data-q="'+q+'"]');
    if(next){
      next.classList.add('active');
      window.scrollTo({top:0,behavior:'smooth'});
      updateProgress(q);
      if(window.fbq)fbq('trackCustom','QuizQuestion',{question:q});
      if(window.clarity)clarity('event','quiz_question_'+q);
      if(q===8){
        if(window.fbq)fbq('trackCustom','QuizCompleted',{angle:sourceAngle,score:totalScore});
        if(window.clarity)clarity('event','quiz_completed');
      }
    }
  }

  document.querySelectorAll('.option').forEach(function(btn){
    btn.addEventListener('click',function(){
      var q=parseInt(this.getAttribute('data-q'),10);
      var val=this.getAttribute('data-val');
      var score=parseInt(this.getAttribute('data-score'),10)||0;
      if(!quizStarted){
        quizStarted=true;
        if(window.fbq)fbq('trackCustom','QuizStarted',{angle:sourceAngle});
        if(window.clarity)clarity('event','quiz_started');
      }
      answers['q'+q]=val;
      totalScore+=score;
      btn.parentElement.querySelectorAll('.option').forEach(function(o){o.classList.remove('selected')});
      btn.classList.add('selected');
      setTimeout(function(){goToQ(q+1)},250);
    });
  });

  document.getElementById('leadForm').addEventListener('submit',function(e){
    e.preventDefault();
    var btn=document.getElementById('submitBtn');
    btn.disabled=true;btn.textContent='Processando…';
    answers.name=document.getElementById('name').value.trim();
    answers.email=document.getElementById('email').value.trim();
    answers.whatsapp=document.getElementById('whatsapp').value.trim();
    answers.score=totalScore;
    answers.angle=sourceAngle;
    var tier;
    if(totalScore>=60)tier=1;else if(totalScore>=35)tier=2;else tier=3;
    answers.tier=tier;
    if(window.fbq){fbq('track','Lead',{tier:tier,score:totalScore,angle:sourceAngle});fbq('trackCustom','Tier'+tier+'Qualified')}
    if(window.clarity){clarity('event','tier_'+tier+'_qualified');clarity('set','tier',String(tier))}
    var formEndpoint='FORM_ENDPOINT';
    if(formEndpoint&&formEndpoint!=='FORM_ENDPOINT'){
      fetch(formEndpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(answers)}).catch(function(){});
    }
    goToQ(9);
    setTimeout(function(){
      var resultParams=new URLSearchParams();
      resultParams.set('tier',tier);
      resultParams.set('score',totalScore);
      resultParams.set('angle',sourceAngle);
      resultParams.set('motivation',answers.q4||'');
      resultParams.set('name',answers.name.split(' ')[0]);
      resultParams.set('channel',answers.q7||'whatsapp');
      window.location.href='result.html?'+resultParams.toString();
    },4200);
  });

  // Intro screen handlers
  var introStart=document.getElementById('introStart');
  var introSkip=document.getElementById('introSkip');
  if(introStart){introStart.addEventListener('click',function(){
    if(window.fbq)fbq('trackCustom','IntroStart',{angle:sourceAngle});
    if(window.clarity)clarity('event','intro_start');
    goToQ(1);
  });}
  if(introSkip){introSkip.addEventListener('click',function(){
    if(window.fbq)fbq('trackCustom','IntroSkip',{angle:sourceAngle});
    if(window.clarity)clarity('event','intro_skip');
    goToQ(1);
  });}

  // Track intro view
  if(window.fbq)fbq('trackCustom','IntroView',{angle:sourceAngle});
  if(window.clarity)clarity('event','intro_view');

  updateProgress(0);
})();
</script>

</body>
</html>
