.intro-ctas{margin-top:20px;display:flex;flex-direction:column;gap:10px}
.intro-cta-primary{display:block;background:var(--g1-red);color:#fff;font-weight:900;font-size:15px;letter-spacing:1px;text-transform:uppercase;padding:18px;border:none;cursor:pointer;text-align:center;font-family:inherit;transition:background .15s}
.intro-cta-primary:hover{background:var(--g1-red-h)}
.intro-skip{text-align:center;font-size:12px;color:var(--g1-muted);background:none;border:none;cursor:pointer;font-family:inherit;padding:10px;text-decoration:underline}
.intro-skip:hover{color:var(--g1-red)}
@media(max-width:600px){.intro-title{font-size:22px}}

