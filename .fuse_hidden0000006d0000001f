<style>
:root{--g1-red:#C4170C;--g1-red-h:#A0120A;--g1-black:#1A1A1A;--g1-text:#333;--g1-muted:#717171;--g1-light:#F2F2F2;--g1-border:#E0E0E0;--g1-link:#0066B3}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:Arial,Helvetica,sans-serif;color:var(--g1-text);background:#fff;line-height:1.5;font-size:16px;display:flex;flex-direction:column;min-height:100vh}

.g1-topbar{background:var(--g1-black);color:#fff;padding:6px 16px;font-size:11px;display:flex;justify-content:space-between;align-items:center}
.g1-header-main{display:flex;align-items:center;padding:12px 24px;border-bottom:4px solid var(--g1-red);background:#fff}
.g1-logo{font-family:'Arial Black',Arial,sans-serif;font-size:36px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;line-height:1}
.g1-section-tag{margin-left:14px;padding-left:14px;border-left:1px solid var(--g1-border);font-size:15px;font-weight:700;color:var(--g1-black);line-height:1;text-transform:uppercase;letter-spacing:.5px}

.progress-wrap{background:var(--g1-light);border-bottom:1px solid var(--g1-border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--g1-muted);letter-spacing:1px;text-transform:uppercase;font-weight:700}
.progress-track{flex:1;height:6px;background:var(--g1-border);margin:0 14px;overflow:hidden}
.progress-fill{height:100%;background:var(--g1-red);width:0%;transition:width .4s ease}

.container{flex:1;max-width:720px;margin:0 auto;padding:32px 24px;width:100%;display:flex;flex-direction:column;justify-content:center}

.question-wrap{display:none;animation:fadeIn .35s ease}
.question-wrap.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.q-kicker{display:inline-block;background:var(--g1-red);color:#fff;padding:4px 11px;font-size:11px;text-transform:uppercase;font-weight:900;letter-spacing:1px;margin-bottom:14px}
.q-title{font-family:Arial,Helvetica,sans-serif;font-size:30px;line-height:1.25;color:var(--g1-black);margin-bottom:8px;font-weight:900;letter-spacing:-.3px}
.q-sub{font-size:15px;color:var(--g1-muted);margin-bottom:28px;line-height:1.5}

.option{display:block;background:#fff;border:1px solid var(--g1-border);padding:18px 22px;margin-bottom:10px;cursor:pointer;transition:all .15s ease;text-align:left;width:100%;font-family:inherit;font-size:16px;color:var(--g1-text);line-height:1.4}
.option:hover{border-color:var(--g1-red);background:#FFF8F7;transform:translateX(4px);box-shadow:-2px 2px 0 var(--g1-red)}
.option.selected{border-color:var(--g1-red);background:#FFF8F7;box-shadow:-2px 2px 0 var(--g1-red)}
.option .opt-label{font-weight:900;color:var(--g1-black);display:block;margin-bottom:4px}
.option .opt-desc{font-size:13px;color:var(--g1-muted)}

.form-field{margin-bottom:18px}
.form-field label{display:block;font-size:12px;font-weight:900;color:var(--g1-black);margin-bottom:6px;letter-spacing:1px;text-transform:uppercase}
.form-field input{width:100%;padding:14px 16px;font-family:inherit;font-size:16px;border:1px solid var(--g1-border);background:#fff;color:var(--g1-text);transition:border-color .2s}
.form-field input:focus{outline:none;border-color:var(--g1-red);box-shadow:-2px 2px 0 var(--g1-red)}
.form-field .hint{font-size:12px;color:var(--g1-muted);margin-top:4px}

.submit-btn{display:block;width:100%;background:var(--g1-red);color:#fff;font-weight:900;font-size:15px;letter-spacing:1px;text-transform:uppercase;padding:18px;border:none;cursor:pointer;transition:background .2s;margin-top:18px;font-family:inherit}
.submit-btn:hover{background:var(--g1-red-h)}
.submit-btn:disabled{background:var(--g1-border);cursor:not-allowed}

.legal{font-size:11px;color:var(--g1-muted);margin-top:16px;line-height:1.5;text-align:center}

.processing{text-align:center;padding:60px 24px}
.processing .spinner{display:inline-block;width:48px;height:48px;border:4px solid var(--g1-border);border-top-color:var(--g1-red);border-radius:50%;animation:spin 1s linear infinite;margin-bottom:24px}
@keyframes spin{to{transform:rotate(360deg)}}
.processing h2{font-size:24px;color:var(--g1-black);margin-bottom:12px;font-weight:900}
.processing .step{font-size:14px;color:var(--g1-muted);margin:6px 0;opacity:0;animation:stepIn .5s forwards}
.processing .step:nth-child(3){animation-delay:.3s}
.processing .step:nth-child(4){animation-delay:1.2s}
.processing .step:nth-child(5){animation-delay:2.1s}
.processing .step:nth-child(6){animation-delay:3s}
@keyframes stepIn{to{opacity:1}}

.g1-footer{background:var(--g1-black);color:#fff;padding:18px 24px;text-align:center;font-size:12px}
.g1-footer .brand{font-family:'Arial Black',Arial,sans-serif;font-size:20px;font-weight:900;color:var(--g1-red);letter-spacing:-1.5px;margin-bottom:4px}
.g1-footer a{color:#FFCFCB;text-decoration:none}
.g1-footer .partner{margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,.15);font-size:11px;opacity:.95;line-height:1.7}
.g1-footer .partner strong{color:var(--g1-red);font-weight:900}

/* INTRO SCREEN (video embed) */
.intro-wrap{max-width:780px;margin:0 auto}
.intro-tag{display:inline-block;background:var(--g1-red);color:#fff;padding:4px 11px;font-size:11px;text-transform:uppercase;font-weight:900;letter-spacing:1px;margin-bottom:12px}
.intro-title{font-family:Arial,Helvetica,sans-serif;font-size:28px;line-height:1.22;color:var(--g1-black);margin-bottom:8px;font-weight:900;letter-spacing:-.3px}
.intro-title .pop{color:var(--g1-red)}
